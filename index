    const $ = (id) => document.getElementById(id);

    function setStatus(msg, tone = "info") {
      const el = $("uploadStatus");
      el.classList.remove("hidden", "bg-slate-100", "text-slate-700", "border-slate-200", "bg-teal-50", "text-teal-800", "border-teal-200", "bg-amber-50", "text-amber-900", "border-amber-200", "bg-rose-50", "text-rose-800", "border-rose-200");
      if (tone === "success") {
        el.classList.add("bg-teal-50", "text-teal-800", "border-teal-200");
      } else if (tone === "warn") {
        el.classList.add("bg-amber-50", "text-amber-900", "border-amber-200");
      } else if (tone === "error") {
        el.classList.add("bg-rose-50", "text-rose-800", "border-rose-200");
      } else {
        el.classList.add("bg-slate-100", "text-slate-700", "border-slate-200");
      }
      el.textContent = msg;
    }

    function splitSentences(text) {
      const clean = (text || "").replace(/\r\n/g, "\n").trim();
      if (!clean) return [];
      const matches = clean.match(/[^.!?。！？\n]+(?:[.!?。！？]+|$)/g) || [clean];
      return matches.map((s) => s.trim()).filter(Boolean);
    }

    function renderPassageInteractive() {
      const container = $("interactivePassage");
      container.innerHTML = "";
      state.sentences = splitSentences(state.passage);

      if (state.sentences.length === 0) {
        container.innerHTML = '<p class="text-slate-400">尚未輸入英文原文。</p>';
        return;
      }

      state.sentences.forEach((sentence, sIdx) => {
        const p = document.createElement("p");
        p.className = "sentence-block";
        p.dataset.sIdx = String(sIdx);
        p.title = "點擊此句可查看整句翻譯與文法提示";

        const tokens = sentence.split(/(\s+)/);
        tokens.forEach((tok) => {
          if (!tok) return;
          if (/^\s+$/.test(tok)) {
            p.appendChild(document.createTextNode(tok));
            return;
          }
          const wordMatch = tok.match(/^([^A-Za-z']*)([A-Za-z][A-Za-z'-]*)([^A-Za-z']*)$/);
          if (wordMatch) {
            const [, prefix, coreWord, suffix] = wordMatch;
            if (prefix) p.appendChild(document.createTextNode(prefix));
            const span = document.createElement("span");
            span.className = "word-chip";
            span.textContent = coreWord;
            span.title = `點擊查詢「${coreWord}」`;
            span.addEventListener("click", (ev) => {
              ev.stopPropagation();
              openWordDictionary(coreWord, sentence);
            });
            p.appendChild(span);
            if (suffix) p.appendChild(document.createTextNode(suffix));
          } else {
            p.appendChild(document.createTextNode(tok));
          }
        });

        p.addEventListener("click", () => {
          document.querySelectorAll(".sentence-block.active-sentence").forEach((el) => el.classList.remove("active-sentence"));
          p.classList.add("active-sentence");
          openSentenceDictionary(sentence, sIdx);
        });

        container.appendChild(p);
      });
    }

    function renderTranslation() {
      const box = $("displayTranslation");
      const lines = (state.translation || "")
        .split(/\n+/)
        .map((l) => l.trim())
        .filter(Boolean);

      if (lines.length === 0) {
        box.innerHTML = '<p class="text-slate-400">尚未填入全文中文翻譯，可點擊左側「自動產生全文中文翻譯」或手動輸入。</p>';
        return;
      }

      box.innerHTML = lines.map((line) => `<p>${escapeHtml(line)}</p>`).join("");
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function speakText(text) {
      if (!("speechSynthesis" in window) || !text) return;
      window.speechSynthesis.cancel();
      const hasEnglish = /[A-Za-z]/.test(text);
      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = hasEnglish ? "en-US" : "zh-TW";
      utter.rate = 0.95;
      window.speechSynthesis.speak(utter);
    }

    async function translateViaFreeApi(text, sl = "en", tl = "zh-TW") {
      const trimmed = (text || "").trim();
      if (!trimmed) return "";
      const chunks = [];
      const sentences = splitSentences(trimmed);
      let buf = "";
      for (const s of sentences) {
        if ((buf + " " + s).length > 420 && buf) {
          chunks.push(buf.trim());
          buf = s;
        } else {
          buf = buf ? buf + " " + s : s;
        }
      }
      if (buf) chunks.push(buf.trim());

      const out = [];
      for (const chunk of chunks) {
        const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=${encodeURIComponent(sl)}&tl=${encodeURIComponent(tl)}&dt=t&q=${encodeURIComponent(chunk)}`;
        const resp = await fetch(url);
        if (!resp.ok) throw new Error("翻譯服務暫時無法連線");
        const data = await resp.json();
        const translatedPart = (data[0] || []).map((item) => item[0] || "").join("");
        out.push(translatedPart.trim());
      }
      return out.join("\n");
    }

    async function openWordDictionary(word, contextSentence = "") {
      const lower = word.toLowerCase();
      state.activeDict = { mode: "word", query: word, meaning: "查詢中...", note: "" };

      $("dictModeBadge").textContent = "單字小字典";
      $("dictQueryText").textContent = word;
      $("dictPhonetic").textContent = contextSentence ? `例句：${contextSentence}` : "";
      $("dictMeaning").textContent = "查詢中文釋義中...";
      $("dictNoteBox").textContent = "正在載入詞性與學習提示...";
      $("btnSaveWord").classList.remove("hidden");
      $("dictModal").classList.remove("hidden");
      $("dictModal").classList.add("flex");

      speakText(word);

      if (BUILTIN_DICT[lower]) {
        const entry = BUILTIN_DICT[lower];
        state.activeDict.meaning = `${entry.pos} ${entry.zh}`;
        state.activeDict.note = entry.note;
        $("dictMeaning").textContent = state.activeDict.meaning;
        $("dictNoteBox").textContent = entry.note;
        return;
      }

      try {
        const zh = await translateViaFreeApi(word, "en", "zh-TW");
        state.activeDict.meaning = zh || "查無中文釋義";
        state.activeDict.note = `已為您查詢「${word}」的中文意思，可按「加入單字庫」收藏複習。`;
        $("dictMeaning").textContent = state.activeDict.meaning;
        $("dictNoteBox").textContent = state.activeDict.note;
      } catch {
        state.activeDict.meaning = "目前離線或無法連線線上詞典，可按上方「發音」聆聽讀音。";
        state.activeDict.note = "建議連接網路以使用即時中英翻譯。";
        $("dictMeaning").textContent = state.activeDict.meaning;
        $("dictNoteBox").textContent = state.activeDict.note;
      }
    }

    async function openSentenceDictionary(sentence, sIdx) {
      state.activeDict = { mode: "sentence", query: sentence, meaning: "翻譯整句中...", note: "" };

      $("dictModeBadge").textContent = "句子小字典";
