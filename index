<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>優華數位版權所有｜互動閱讀練習</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
  <style>
    :root {
      --bg-paper: #faf8f3;
      --ink-main: #1e293b;
      --accent-teal: #0f766e;
      --accent-amber: #d97706;
    }
    body {
      background-color: var(--bg-paper);
      color: var(--ink-main);
      font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", system-ui, -apple-system, sans-serif;
    }
    .word-chip {
      display: inline;
      cursor: pointer;
      border-radius: 4px;
      padding: 1px 2px;
      transition: background-color 0.15s ease, color 0.15s ease;
    }
    .word-chip:hover {
      background-color: #ccfbf1;
      color: #115e59;
    }
    .sentence-block {
      cursor: pointer;
      border-left: 3px solid transparent;
      padding-left: 8px;
      margin-left: -11px;
      border-radius: 0 8px 8px 0;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }
    .sentence-block:hover {
      background-color: #f0fdfa;
      border-left-color: #0d9488;
    }
    .sentence-block.active-sentence {
      background-color: #fef3c7;
      border-left-color: #d97706;
    }
    .blank-slot {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 68px;
      padding: 0 8px;
      margin: 0 3px;
      border-bottom: 2px solid #0f766e;
      background-color: #f0fdfa;
      color: #0f766e;
      font-weight: 700;
      border-radius: 6px 6px 0 0;
    }
    @media print {
      .no-print { display: none !important; }
      body { background: #fff !important; }
      .print-card { box-shadow: none !important; border: 1px solid #cbd5e1 !important; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">
  <!-- 頂部導覽 -->
  <header class="bg-slate-900 text-white shadow-md no-print sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-teal-500/20 border border-teal-400/40 flex items-center justify-center text-teal-300 font-black text-lg">
          優
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-extrabold tracking-wide">優華數位版權所有｜互動閱讀練習</h1>
            <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-400/20 text-amber-200 border border-amber-300/30 font-semibold">互動版型</span>
          </div>
          <p class="text-xs text-slate-300">支援 PDF / Word / JPG 上傳轉互動練習｜點字句查小字典｜自動選擇題｜原文＋全文翻譯</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button id="btnLoadSample" type="button" class="px-3 py-1.5 rounded-lg bg-teal-600 hover:bg-teal-500 text-white text-xs sm:text-sm font-bold transition">
          載入範例（Laika 太空小狗）
        </button>
        <button id="btnPrintPage" type="button" onclick="window.print()" class="px-3 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 text-xs sm:text-sm font-semibold transition">
          列印 / 存 PDF
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1">
    <!-- 左側：管理者上傳與設定面板 -->
    <aside class="lg:col-span-4 space-y-5 no-print">
      <section class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-base font-extrabold text-slate-800 flex items-center gap-2">
            <span class="w-2 h-5 rounded-full bg-teal-600"></span>
            管理者檔案上傳區
          </h2>
          <span class="text-xs text-slate-400">PDF · DOCX · JPG/PNG</span>
        </div>

        <label id="dropZone" for="fileInput" class="block border-2 border-dashed border-teal-300 hover:border-teal-500 bg-teal-50/40 hover:bg-teal-50/80 rounded-2xl p-5 text-center cursor-pointer transition">
          <div class="text-2xl mb-1">📄🖼️📝</div>
          <div class="text-sm font-bold text-slate-700">點擊選擇或拖曳檔案至此</div>
          <div class="text-xs text-slate-500 mt-1">支援 PDF、Word (.docx)、JPG / PNG 圖片（含 OCR 辨識）</div>
          <input id="fileInput" type="file" accept=".pdf,.docx,.jpg,.jpeg,.png,.webp,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/*" class="hidden" />
        </label>

        <div id="uploadStatus" class="hidden rounded-xl px-3.5 py-2.5 text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200"></div>

        <!-- 課程資訊設定 -->
        <div class="grid grid-cols-2 gap-3 pt-1">
          <div>
            <label class="block text-xs font-bold text-slate-600 mb-1">年級／程度標籤</label>
            <input id="metaLevel" type="text" value="國八程度" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 mb-1">題型／主題標籤</label>
            <input id="metaTopic" type="text" value="克漏字與閱讀測驗" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">文章標題</label>
          <input id="metaTitle" type="text" value="Laika: The Little Dog Who Traveled to Space" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-bold text-slate-600">英文原文（可自由編輯或由檔案匯入）</label>
            <button id="btnAutoTranslate" type="button" class="text-xs font-bold text-teal-700 hover:text-teal-900 underline">
              自動產生全文中文翻譯
            </button>
          </div>
          <textarea id="sourceTextInput" rows="7" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-teal-500" placeholder="貼上或上傳英文文章..."></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">全文中文翻譯（顯示於原文下方）</label>
          <textarea id="translationTextInput" rows="6" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs sm:text-sm leading-relaxed focus:outline-none focus:ring-2 focus:ring-teal-500" placeholder="貼上或自動生成全文中文翻譯..."></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3 items-center">
          <div>
            <label class="block text-xs font-bold text-slate-600 mb-1">自動出題數量</label>
            <select id="quizCountSelect" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-teal-500">
              <option value="5" selected>5 題選擇題</option>
              <option value="8">8 題選擇題</option>
              <option value="10">10 題選擇題</option>
            </select>
          </div>
          <div class="pt-5">
            <button id="btnBuildInteractive" type="button" class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-extrabold shadow transition">
              生成互動練習頁
            </button>
          </div>
        </div>
      </section>

      <!-- 單字庫管理小卡 -->
      <section class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-extrabold text-slate-800">我的收藏單字庫 (<span id="savedVocabCount">0</span>)</h3>
          <button id="btnClearVocab" type="button" class="text-xs text-rose-600 hover:underline font-semibold">清空</button>
        </div>
        <div id="savedVocabList" class="flex flex-wrap gap-1.5 max-h-36 overflow-y-auto text-xs">
          <span class="text-slate-400">點選文章中的單字後可加入收藏</span>
        </div>
      </section>
    </aside>

    <!-- 右側：學生互動練習主區（1. 點字句小字典 2. 自動選擇題 3. 上原文下翻譯） -->
    <section class="lg:col-span-8 space-y-6">
      <!-- 區塊 3：全文對照區（上面原文、下面翻譯 + 點字/點句查字典） -->
      <article class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-7 print-card space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-4">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <span id="badgeLevel" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teal-100 text-teal-800">國八程度</span>
              <span id="badgeTopic" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">克漏字與閱讀測驗</span>
              <span class="text-xs font-semibold text-slate-400">優華數位版權所有</span>
            </div>
            <h2 id="displayTitle" class="text-xl sm:text-2xl font-black text-slate-900">Laika: The Little Dog Who Traveled to Space</h2>
          </div>

          <div class="flex items-center gap-2 no-print text-xs">
            <span class="px-2.5 py-1 rounded-lg bg-teal-50 text-teal-700 border border-teal-200 font-semibold">
              💡 點「單字」查詞義
            </span>
            <span class="px-2.5 py-1 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 font-semibold">
              💬 點「整句」翻句子
            </span>
          </div>
        </div>

        <!-- 上：英文原文互動區 -->
        <div class="space-y-2.5">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-extrabold uppercase tracking-wider text-teal-800 bg-teal-50 px-3 py-1 rounded-lg border border-teal-200/70">
              ▲ 英文原文（點擊任一單字查字典；點擊整句看句意與解析）
            </h3>
            <button id="btnSpeakPassage" type="button" class="no-print text-xs font-bold text-teal-700 hover:bg-teal-50 px-2.5 py-1 rounded-lg border border-teal-200 transition">
              🔊 朗讀原文
            </button>
          </div>
          <div id="interactivePassage" class="text-base sm:text-[17px] leading-[2.05] text-slate-800 space-y-3 pt-1"></div>
        </div>

        <!-- 下：全文中文翻譯區 -->
        <div class="border-t-2 border-dashed border-slate-200 pt-5 space-y-2.5">
          <div class="flex items-center justify-between">
            <h3 class="text-sm font-extrabold uppercase tracking-wider text-amber-900 bg-amber-50 px-3 py-1 rounded-lg border border-amber-200/80">
              ▼ 全文中文翻譯
            </h3>
            <span class="text-xs text-slate-400">原文對照譯文</span>
          </div>
          <div id="displayTranslation" class="text-sm sm:text-base leading-[1.95] text-slate-700 bg-amber-50/40 rounded-2xl p-4 sm:p-5 border border-amber-200/60 space-y-2.5"></div>
        </div>
      </article>

      <!-- 區塊 2：自動生成選擇題區 -->
      <section class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-5 sm:p-7 print-card space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4">
          <div>
            <h3 class="text-lg sm:text-xl font-black text-slate-900 flex items-center gap-2">
              <span>自動生成選擇題測驗</span>
              <span id="quizScoreBadge" class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">
                作答進度：0 / 5
              </span>
            </h3>
            <p class="text-xs text-slate-500 mt-0.5">依據上傳文章的重點詞彙與句意自動出題，點擊選項立即批改並顯示解析。</p>
          </div>
          <div class="flex items-center gap-2 no-print">
            <button id="btnRegenQuiz" type="button" class="px-3 py-1.5 rounded-xl bg-teal-600 hover:bg-teal-500 text-white text-xs sm:text-sm font-bold transition">
              重新出題
            </button>
            <button id="btnResetQuiz" type="button" class="px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs sm:text-sm font-bold transition">
              清除作答
            </button>
          </div>
        </div>

        <div id="quizList" class="space-y-4"></div>
      </section>
    </section>
  </main>

  <!-- 區塊 1：小字典彈出視窗（查單字 / 查句子） -->
  <div id="dictModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/50 backdrop-blur-[2px] p-4" role="dialog" aria-modal="true">
    <div class="bg-white rounded-3xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden animate-fadeIn">
      <div class="bg-slate-900 text-white px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span id="dictModeBadge" class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-teal-500/20 text-teal-300 border border-teal-400/30">單字小字典</span>
          <span class="text-xs text-slate-400">優華數位版權所有</span>
        </div>
        <button id="btnCloseDict" type="button" class="text-slate-300 hover:text-white text-xl font-bold leading-none px-2">×</button>
      </div>

      <div class="p-6 space-y-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <div id="dictQueryText" class="text-xl sm:text-2xl font-black text-slate-900 break-words"></div>
            <div id="dictPhonetic" class="text-xs text-teal-700 font-semibold mt-0.5"></div>
          </div>
          <button id="btnSpeakDict" type="button" class="shrink-0 px-3 py-1.5 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-800 border border-teal-200 text-xs font-bold transition">
            🔊 發音
          </button>
        </div>

        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200 space-y-2">
          <div class="text-xs font-bold text-slate-500">中文釋義 / 翻譯</div>
          <div id="dictMeaning" class="text-sm sm:text-base font-bold text-slate-800 leading-relaxed">查詢中...</div>
        </div>

        <div id="dictNoteBox" class="bg-amber-50/70 rounded-2xl p-3.5 border border-amber-200/80 text-xs sm:text-sm text-slate-700 leading-relaxed"></div>

        <div class="flex items-center justify-between gap-2 pt-2">
          <button id="btnSaveWord" type="button" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs sm:text-sm font-extrabold transition">
            ★ 加入單字庫
          </button>
          <button id="btnOkDict" type="button" class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-bold transition">
            知道了
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    const SAMPLE_DATA = {
      level: "國八程度",
      topic: "克漏字與閱讀測驗",
      title: "Laika: The Little Dog Who Traveled to Space",
      passage: [
        "In 1957, Laika was a small stray dog who had no home on the cold streets of Russia.",
        "She looked cute and very quiet, and her fur felt soft.",
        "Because she was friendly and calm, scientists chose her for a special trip to space.",
        "They put her inside a small spaceship which was named Sputnik 2.",
        "Inside the dark box, the air smelled strange, and the small room felt cold at first.",
        "When the rocket went up, the loud noise sounded like thunder.",
        "Laika could hear the loud machines and feel the ship shaking.",
        "Everything around her was scary.",
        "For many years, people thought Laika died peacefully after a week.",
        "However, the true story sounded very sad.",
        "In fact, the machine inside the spaceship broke, so the room quickly became too hot.",
        "Poor Laika died from the heat and fear just a few hours later.",
        "She never came back to Earth.",
        "Today, Laika's story teaches us to respect life.",
        "Animals are our friends, not just tools for science.",
        "They can feel pain and fear, just like us.",
        "We should always be kind to every living animal and protect them."
      ].join(" "),
      translation: [
        "1957年，萊卡是一隻在俄羅斯寒冷街頭無家可歸的小流浪狗。",
        "牠看起來可愛又安靜，毛皮摸起來很柔軟。",
        "因為牠友善又冷靜，科學家挑選牠進行一趟特別的太空之旅。",
        "他們把牠放進一艘名為史普尼克2號的小型太空船裡。",
        "在黑暗的艙內，空氣聞起來很奇怪，小空間一開始感覺很冷。",
        "當火箭升空時，巨大的聲響聽起來像打雷。",
        "萊卡能聽見吵雜的機器聲，並感覺到太空船在震動。",
        "周圍的一切都很可怕。",
        "多年來，人們以為萊卡在一週後平靜地死去。",
        "然而，真實的故事聽起來非常難過。",
        "事實上，太空船裡的機器壞了，所以艙內很快就變得太熱。",
        "可憐的萊卡在幾小時後就因高溫與恐懼而死去。",
        "牠再也沒有回到地球。",
        "如今，萊卡的故事教導我們要尊重生命。",
        "動物是我們的朋友，不只是科學的工具。",
        "牠們像我們一樣會感到疼痛與恐懼。",
        "我們應該永遠對每一個活著的動物友善並保護牠們。"
      ].join("\n")
    };

    const BUILTIN_DICT = {
      "stray": { pos: "adj. / n.", zh: "走失的；流浪的；流浪動物", note: "stray dog 指「流浪狗」。" },
      "russia": { pos: "n.", zh: "俄羅斯", note: "專有名詞，首字母需大寫。" },
      "quiet": { pos: "adj.", zh: "安靜的；寂靜的", note: "連綴動詞 look / feel / be 後面常接形容詞 quiet（注意與副詞 quietly 區分）。" },
      "fur": { pos: "n.", zh: "（動物的）軟毛；毛皮", note: "不可數名詞，指貓狗身上的細毛。" },
      "soft": { pos: "adj.", zh: "柔軟的；柔和的", note: "feel soft 表示「摸起來柔軟」。" },
      "friendly": { pos: "adj.", zh: "友善的；友好的", note: "雖然字尾有 -ly，但它是形容詞；常用搭配 be friendly to sb." },
      "calm": { pos: "adj. / v.", zh: "冷靜的；平靜的；使平靜", note: "stay calm 表示「保持冷靜」。" },
      "scientist": { pos: "n.", zh: "科學家", note: "由 science（科學）加上 -ist 構成。" },
      "chose": { pos: "v.", zh: "選擇（choose 的過去式）", note: "三態變化：choose - chose - chosen。" },
      "choose": { pos: "v.", zh: "選擇；挑選", note: "過去式為 chose。" },
      "space": { pos: "n.", zh: "太空；空間", note: "travel into space「進入太空」（space 指太空時通常不加冠詞）。" },
      "spaceship": { pos: "n.", zh: "太空船", note: "由 space + ship 合成的複合名詞。" },
      "smelled": { pos: "v.", zh: "聞起來（smell 的過去式）", note: "感官／連綴動詞 smell + 形容詞，如 smelled strange。" },
      "strange": { pos: "adj.", zh: "奇怪的；陌生的", note: "air smelled strange「空氣聞起來很奇怪」。" },
      "rocket": { pos: "n.", zh: "火箭", note: "when the rocket went up「當火箭升空時」。" },
      "noise": { pos: "n.", zh: "噪音；聲響", note: "loud noise「巨大的聲響」。" },
      "sounded": { pos: "v.", zh: "聽起來（sound 的過去式）", note: "sound like + 名詞，表示「聽起來像……」。" },
      "thunder": { pos: "n.", zh: "雷；雷聲", note: "sound like thunder「聽起來像打雷」。" },
      "machine": { pos: "n.", zh: "機器", note: "可數名詞，複數為 machines。" },
