    });

    $("btnSaveWord").addEventListener("click", () => {
      if (!state.activeDict || state.activeDict.mode !== "word") return;
      const w = state.activeDict.query.toLowerCase();
      const exists = state.savedVocab.some((item) => item.word.toLowerCase() === w);
      if (!exists) {
        state.savedVocab.unshift({
          word: state.activeDict.query,
          meaning: state.activeDict.meaning
        });
        renderSavedVocab();
      }
      closeDictionary();
    });

    $("btnClearVocab").addEventListener("click", () => {
      state.savedVocab = [];
      renderSavedVocab();
    });

    $("fileInput").addEventListener("change", (e) => {
      const f = e.target.files?.[0];
      if (f) handleFileUpload(f);
      e.target.value = "";
    });

    const dropZone = $("dropZone");
    ["dragenter", "dragover"].forEach((evt) => {
      dropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropZone.classList.add("border-teal-600", "bg-teal-100/60");
      });
    });
    ["dragleave", "drop"].forEach((evt) => {
      dropZone.addEventListener(evt, (e) => {
        e.preventDefault();
        dropZone.classList.remove("border-teal-600", "bg-teal-100/60");
      });
    });
    dropZone.addEventListener("drop", (e) => {
      const f = e.dataTransfer?.files?.[0];
      if (f) handleFileUpload(f);
    });

    // 初始化示範內容
    loadSample();
    renderSavedVocab();
  </script>
</body>
</html>
