      $("btnSaveWord").classList.add("hidden");
      $("dictModal").classList.remove("hidden");
      $("dictModal").classList.add("flex");

      const transLines = (state.translation || "").split(/\n+/).map((s) => s.trim()).filter(Boolean);
      if (transLines[sIdx] && state.sentences.length === transLines.length) {
        state.activeDict.meaning = transLines[sIdx];
        $("dictMeaning").textContent = transLines[sIdx];
