    function generateAutoQuestions() {
      const count = parseInt($("quizCountSelect").value, 10) || 5;
      const sentences = splitSentences(state.passage);
      const allWords = (state.passage.match(/[A-Za-z]{4,}/g) || [])
        .map((w) => w.toLowerCase())
        .filter((w) => !["that", "this", "with", "from", "they", "them", "their", "there", "were", "have", "what", "when", "into", "some", "very", "after", "before", "about", "could", "would", "should"].includes(w));

      const uniquePool = [...new Set(allWords)];
      const candidates = sentences.filter((s) => {
        const ws = s.match(/[A-Za-z]{4,}/g) || [];
        return ws.length >= 4 && uniquePool.some((u) => s.toLowerCase().includes(u));
      });

      const chosenSentences = [...candidates].sort(() => Math.random() - 0.5).slice(0, count);
      const questions = [];

      chosenSentences.forEach((sent, idx) => {
        const sentWords = (sent.match(/\b[A-Za-z]{4,}\b/g) || [])
          .filter((w) => uniquePool.includes(w.toLowerCase()));
        const targetWord = (sentWords[Math.floor(Math.random() * sentWords.length)] || "space");
        const targetLower = targetWord.toLowerCase();

        const distractors = uniquePool
          .filter((w) => w !== targetLower && Math.abs(w.length - targetLower.length) <= 4)
          .sort(() => Math.random() - 0.5)
          .slice(0, 3);

        while (distractors.length < 3) {
          const fallback = ["friendly", "quiet", "rocket", "protect", "respect", "scary", "machine", "future"]
            .find((f) => f !== targetLower && !distractors.includes(f)) || "story";
          distractors.push(fallback);
        }

        const options = [targetLower, ...distractors].sort(() => Math.random() - 0.5);
        const answer = options.indexOf(targetLower);
        const clozeSentence = sent.replace(new RegExp(`\\b${targetWord}\\b`, "i"), "_____");
        const dictInfo = BUILTIN_DICT[targetLower];

        questions.push({
          id: `q_${Date.now()}_${idx}`,
          questionText: clozeSentence,
          options,
          answer,
          targetWord: targetLower,
          explanation: dictInfo
            ? `正確答案為「${targetLower}」（${dictInfo.zh}）。${dictInfo.note}`
            : `正確答案為「${targetLower}」，請結合前後文句意判斷最合適的詞彙。`
        });
      });

      state.questions = questions;
      state.answers = {};
      renderQuizList();
    }

    function renderQuizList() {
      const listEl = $("quizList");
      const total = state.questions.length;
      const answeredCount = Object.keys(state.answers).length;
      const correctCount = Object.entries(state.answers).filter(([qIdx, optIdx]) => state.questions[Number(qIdx)]?.answer === optIdx).length;

      $("quizScoreBadge").textContent = `作答進度：${answeredCount} / ${total}（答對 ${correctCount} 題）`;

      if (total === 0) {
        listEl.innerHTML = '<p class="text-slate-400 text-sm">文章內容較短，請輸入或上傳更多英文段落以自動生成選擇題。</p>';
        return;
      }

      const labels = ["A", "B", "C", "D"];
      listEl.innerHTML = state.questions.map((q, qIdx) => {
        const picked = state.answers[qIdx];
        const hasPicked = picked !== undefined;
        const isCorrect = hasPicked && picked === q.answer;

        const optionsHtml = q.options.map((opt, oIdx) => {
          let styleClass = "border-slate-200 bg-white hover:bg-slate-50 text-slate-800";
          if (hasPicked) {
            if (oIdx === q.answer) {
              styleClass = "border-emerald-500 bg-emerald-50 text-emerald-900 font-bold";
            } else if (oIdx === picked && oIdx !== q.answer) {
              styleClass = "border-rose-400 bg-rose-50 text-rose-900";
            } else {
              styleClass = "border-slate-200 bg-slate-50/60 text-slate-500";
            }
          }
          return `
            <button type="button" onclick="selectAnswer(${qIdx}, ${oIdx})" class="w-full text-left px-4 py-2.5 rounded-xl border text-sm transition flex items-center gap-2.5 ${styleClass}">
              <span class="w-6 h-6 rounded-full border border-current flex items-center justify-center text-xs font-extrabold shrink-0">${labels[oIdx]}</span>
              <span>${escapeHtml(opt)}</span>
            </button>
          `;
        }).join("");

        const feedbackHtml = hasPicked ? `
          <div class="mt-3 p-3.5 rounded-xl text-xs sm:text-sm leading-relaxed ${isCorrect ? "bg-emerald-50 text-emerald-900 border border-emerald-200" : "bg-amber-50 text-amber-950 border border-amber-200"}">
            <div class="font-extrabold mb-0.5">${isCorrect ? "✓ 答對了！" : `✗ 再想想，正確選項為 (${labels[q.answer]}) ${escapeHtml(q.options[q.answer])}`}</div>
            <div>${escapeHtml(q.explanation)}</div>
          </div>
        ` : "";

        return `
          <div class="rounded-2xl border border-slate-200/90 bg-slate-50/40 p-4 sm:p-5">
            <div class="text-xs font-bold text-teal-700 mb-1">第 ${qIdx + 1} 題</div>
            <div class="text-sm sm:text-base font-bold text-slate-900 mb-3 leading-relaxed">${escapeHtml(q.questionText)}</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              ${optionsHtml}
            </div>
            ${feedbackHtml}
          </div>
        `;
      }).join("");
    }

    function selectAnswer(qIdx, oIdx) {
      state.answers[qIdx] = oIdx;
      renderQuizList();
    }

    async function extractTextFromPdf(file) {
      const buf = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: buf }).promise;
      let fullText = "";
      for (let p = 1; p <= pdf.numPages; p++) {
        const page = await pdf.getPage(p);
        const content = await page.getTextContent();
        const pageStr = content.items.map((it) => it.str).join(" ");
        fullText += pageStr + "\n";
      }
      return fullText.trim();
    }

    async function extractTextFromDocx(file) {
      const buf = await file.arrayBuffer();
      const result = await mammoth.extractRawText({ arrayBuffer: buf });
      return (result.value || "").trim();
    }

    async function extractTextFromImage(file) {
      setStatus("正在進行圖片文字辨識（OCR），請稍候...", "info");
      const worker = await Tesseract.createWorker("eng+chi_tra");
      const { data } = await worker.recognize(file);
      await worker.terminate();
      return (data.text || "").trim();
    }

    async function handleFileUpload(file) {
      if (!file) return;
      const name = file.name.toLowerCase();
      setStatus(`正在讀取檔案「${file.name}」...`, "info");

      try {
        let extracted = "";
        if (name.endsWith(".pdf") || file.type === "application/pdf") {
          extracted = await extractTextFromPdf(file);
        } else if (name.endsWith(".docx") || file.type.includes("wordprocessingml")) {
          extracted = await extractTextFromDocx(file);
        } else if (/\.(jpg|jpeg|png|webp)$/.test(name) || file.type.startsWith("image/")) {
          extracted = await extractTextFromImage(file);
        } else {
          setStatus("不支援的檔案格式，請上傳 PDF、Word (.docx) 或 JPG/PNG 圖片。", "error");
          return;
        }

        if (!extracted) {
          setStatus("檔案中未擷取到文字，若是掃描版 PDF 建議轉為 JPG 後重新上傳。", "warn");
          return;
        }

        const cleaned = extracted.replace(/\s+/g, " ").trim();
        $("sourceTextInput").value = cleaned;
        const firstLine = file.name.replace(/\.[^.]+$/, "");
        $("metaTitle").value = firstLine;

        setStatus(`已成功從「${file.name}」擷取內容，正在自動翻譯與出題...`, "success");
        await applyInputsAndGenerate(true);
      } catch (err) {
        setStatus(`檔案處理失敗：${err.message || err}`, "error");
      }
    }

    async function applyInputsAndGenerate(autoTranslateMissing = false) {
      state.level = ($("metaLevel").value || "一般程度").trim();
      state.topic = ($("metaTopic").value || "閱讀測驗").trim();
      state.title = ($("metaTitle").value || "互動閱讀文章").trim();
      state.passage = ($("sourceTextInput").value || "").trim();
      state.translation = ($("translationTextInput").value || "").trim();

      $("badgeLevel").textContent = state.level;
      $("badgeTopic").textContent = state.topic;
      $("displayTitle").textContent = state.title;

      renderPassageInteractive();

      if (autoTranslateMissing && state.passage && !state.translation) {
        try {
          const zh = await translateViaFreeApi(state.passage, "en", "zh-TW");
          state.translation = zh;
          $("translationTextInput").value = zh;
        } catch {
          // 保留空白或手動填寫提示
        }
      }

      renderTranslation();
      generateAutoQuestions();
    }

