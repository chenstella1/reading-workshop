        return;
      }

      try {
        const zhSentence = await translateViaFreeApi(sentence, "en", "zh-TW");
        state.activeDict.meaning = zhSentence || "無法取得句意翻譯";
        $("dictMeaning").textContent = state.activeDict.meaning;
        $("dictNoteBox").textContent = "已自動翻譯此句；點選單字可查詢個別詞彙釋義。";
